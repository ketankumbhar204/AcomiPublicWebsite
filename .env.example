# Base URL of the ACOMI backend, including the /api/v1 prefix.
# Only public configuration belongs in this file: Vite inlines every VITE_* value
# into the browser bundle, so never put secrets or provider credentials here.
VITE_API_BASE_URL=http://localhost:8080/api/v1
# Authenticated web app — used to continue Contact / Enquire after sign-in.
VITE_APP_ORIGIN=http://localhost:5173
# Official Play Store listing for “Open ACOMI App” fallback (default: com.acomi).
# VITE_ANDROID_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.acomi
